<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aven.Native — coquille WinUI 3 (phase 0 : fenêtre vide buildée en CI, MSIX artefact).
       Le pont (Aven.Bridge) et les services arrivent en phases 1-6 du protocole
       MIGRATION-WINUI.md. Le packaging est préparé pour la signature (phase 7) :
       AppxPackageSigningEnabled=false tant qu'aucun certificat n'est stocké. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Aven.Native</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Runtime .NET embarqué (phase 7) : WindowsAppSDKSelfContained couvre le WASDK
         seulement — sans SelfContained, l'app exige le host .NET partagé et refuse de
         démarrer sur toute machine sans le framework 8.0 exact (constaté localement). -->
    <SelfContained Condition="'$(Platform)' != ''">true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <DefaultLanguage>fr-fr</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aven.Bridge\Aven.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- J7 (04/10/2026) : seul tray.ico du tray est copié dans l'output (donc dans le
         zip portable) — le wildcard Content ne va qu'au MSIX. Copier Assets/terminal
         out aussi activerait l'écran VT WebView2 dans le portable : l'arbre UIA s'y
         arrête alors au panneau WebView2 (constaté au probe du 04/10), rendant les
         contrôles du bas inaccessibles aux clients d'accessibilité ET au smoke. -->
    <Content Include="Assets\**\*" />
    <Content Update="Assets\tray.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Package.appxmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

</Project>
