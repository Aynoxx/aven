<?xml version="1.0" encoding="utf-8"?><Window    x:Class="Aven.Native.MainWindow"    Title="Aven"    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"    mc:Ignorable="d">    <Grid x:Name="Racine">        <Grid.RowDefinitions>            <RowDefinition Height="48" />            <RowDefinition Height="Auto" />            <RowDefinition Height="*" />        </Grid.RowDefinitions>        <!-- &#9472;&#9472; Title bar custom (parit&#233; v9.7 : En ligne / Param&#232;tres / Accueil) &#9472;&#9472; -->        <Grid Grid.Row="0" x:Name="TitleBar" Height="48" Background="Transparent">            <Grid.ColumnDefinitions>                <ColumnDefinition Width="*" />                <ColumnDefinition Width="Auto" />            </Grid.ColumnDefinitions>            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,0,0">                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{ThemeResource AvenSuccessBrush}" />                <TextBlock x:Name="StatusBarre" Text="D&#233;marrage" FontSize="12" VerticalAlignment="Center"                           Foreground="{ThemeResource AvenMutedBrush}" />                <TextBox x:Name="HubCommande" PlaceholderText="Demander, chercher, cr&#233;er&#8230;" Width="240" MinHeight="30" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" KeyDown="OnHubCommande" AutomationProperties.Name="Rechercher ou commander" Background="{ThemeResource AvenPanelBrush}" BorderBrush="{ThemeResource AvenBorderBrush}" Foreground="{ThemeResource AvenTextBrush}" /><Button x:Name="FreebuffButton" Content="Terminal Freebuff" Click="OnPastilleFreebuff" FontSize="12" MinHeight="30"                        Background="Transparent" BorderThickness="0" Padding="10,4" Margin="8,0,0,0"                        Foreground="{ThemeResource AvenAccentBrush}" />                <Button x:Name="SettingsButton" Content="Param&#232;tres" FontSize="12" MinHeight="30"                        Background="Transparent" BorderThickness="0" Padding="10,4"                        Foreground="{ThemeResource AvenTextBrush}" Click="OnSettings" />                <Button x:Name="HomeButton" Content="&#8592; Accueil" FontSize="12" MinHeight="30"                        Background="Transparent" BorderThickness="0" Padding="10,4"                        Foreground="{ThemeResource AvenTextBrush}" Click="OnHome" />            </StackPanel>        </Grid>        <!-- &#9472;&#9472; Contenu : hub ou page cible (navigation anim&#233;e) &#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472; -->        <!-- Banni&#232;res d'&#233;tat (parit&#233; status-banner du web) : d&#233;marrage, &#233;chec             du moteur, aucun fournisseur avec cl&#233; — visibles HORS hub. -->        <StackPanel Grid.Row="1" Spacing="4">            <Border x:Name="StatusBanner" Visibility="Collapsed" Background="{ThemeResource AvenPanelSoftBrush}"                    BorderBrush="{ThemeResource AvenBorderBrush}" BorderThickness="1" CornerRadius="10"                    Padding="12,8" Margin="16,8,16,0">                <TextBlock x:Name="StatusBannerText" TextWrapping="Wrap" FontSize="13"                           Foreground="{ThemeResource AvenTextBrush}" />            </Border>            <Border x:Name="NoKeyBanner" Visibility="Collapsed" Background="{ThemeResource AvenPanelSoftBrush}"                    BorderBrush="{ThemeResource AvenBorderBrush}" BorderThickness="1" CornerRadius="10"                    Padding="12,8" Margin="16,8,16,0">                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AvenMutedBrush}"                           Text="Aucun fournisseur avec cl&#233; API n&#39;est configur&#233;. Les mod&#232;les sans cl&#233; restent disponibles." />            </Border>        </StackPanel>        <!-- Contenu : hub ou page cible (navigation anim&#233;e) -->        <Grid Grid.Row="2">            <!-- HUB : 4 cartes &#224; 90&#176; autour du centre (parit&#233; .home-hub) -->            <Grid x:Name="HubView" Visibility="Visible">                <Grid.ColumnDefinitions>                    <ColumnDefinition Width="Auto" />                    <ColumnDefinition Width="*" />                </Grid.ColumnDefinitions>                <!-- R&#201;CENTS (parit&#233; .home-recent du hub web) : 3 derni&#232;res                     conversations, clic = r&#233;ouverture. Nom UIA pr&#233;fix&#233; « Reprendre : »                     pour ne jamais croiser les pr&#233;fixes de clic du smoke (« Projet »…). -->                <StackPanel Grid.Column="0" x:Name="HubRecents" Width="240" Margin="20,0,0,0"                            VerticalAlignment="Center" Spacing="8">                    <TextBlock Text="R&#201;CENTS" FontSize="11" FontWeight="SemiBold"                               Foreground="{ThemeResource AvenAccentBrush}" />                    <TextBlock Text="Reprendre rapidement" FontSize="14" FontWeight="SemiBold"                               Foreground="{ThemeResource AvenTextBrush}" />                    <StackPanel x:Name="HubRecentsList" Spacing="4" />                </StackPanel>                <Grid Grid.Column="1" x:Name="HubScene" SizeChanged="SurTailleSceneHub">                <Grid.Resources>                    <Style TargetType="Button" x:Key="HubCardStyle">                        <Setter Property="Width" Value="150" />                        <Setter Property="Height" Value="112" />                        <Setter Property="CornerRadius" Value="22" />                        <Setter Property="Background" Value="{ThemeResource AvenPanelBrush}" />                        <Setter Property="BorderBrush" Value="{ThemeResource AvenBorderBrush}" />                        <Setter Property="BorderThickness" Value="1" />                    </Style>                </Grid.Resources>                <!-- Anneau + textes centraux : taille de l'anneau pilotée en C# (correctif                     04/10/2026 : elle suit le rayon dynamique des cartes au lieu d'un 540 fixe).                     Correctif 04/10/2026 : les trois lignes centrales vivaient dans TROIS                     TextBlocks VerticalAlignment=Center séparés — en WinUI, la marge haute                     compte pour MOITIÉ dans un centrage (le slot centré inclut la marge),                     donc « +24 » ne descendait que de 12 px : les trois textes se                     superposaient au centre (constaté sur capture 1366×720). Un StackPanel                     empile proprement, quelles que soient les tailles de police. -->                <Ellipse x:Name="HubAnneau" Width="540" Height="540" Stroke="{ThemeResource AvenAccentBorderBrush}"                         StrokeThickness="1" Opacity="0.35" />                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">                    <TextBlock x:Name="HubTitle" Text="Aven" FontSize="30" FontWeight="SemiBold"                               HorizontalAlignment="Center"                               Foreground="{ThemeResource AvenTextBrush}" />                    <TextBlock x:Name="HubWorkspace" Text="Espace de travail" FontSize="12"                               HorizontalAlignment="Center"                               Foreground="{ThemeResource AvenTextBrush}" />                    <TextBlock Text="Moteur OpenCode &#183; sidecar aven-engine-host.mjs" FontSize="12"                               HorizontalAlignment="Center"                               Foreground="{ThemeResource AvenMutedBrush}" />                </StackPanel>                <Button x:Name="CardProject" Style="{StaticResource HubCardStyle}"                        Tag="0" Click="OnHubCard" AutomationProperties.Name="Projet &#8212; agent central (Freebuff)">                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">                        <TextBlock Text="&#9670;" FontSize="24" Foreground="{ThemeResource AvenAccentBrush}" HorizontalAlignment="Center" />                        <TextBlock Text="Projet" FontWeight="SemiBold" HorizontalAlignment="Center"                                   Foreground="{ThemeResource AvenTextBrush}" />                        <TextBlock Text="Agent central (Freebuff)" FontSize="10" TextWrapping="Wrap" TextAlignment="Center"                                   Foreground="{ThemeResource AvenMutedBrush}" />                    </StackPanel>                </Button>                <Button x:Name="CardTasks" Style="{StaticResource HubCardStyle}"                        Tag="1" Click="OnHubCard" AutomationProperties.Name="T&#226;ches &#8212; sp&#233;cialistes par t&#226;che">                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">                        <TextBlock Text="&#8984;" FontSize="24" Foreground="{ThemeResource AvenAccentBrush}" HorizontalAlignment="Center" />                        <TextBlock Text="T&#226;ches" FontWeight="SemiBold" HorizontalAlignment="Center"                                   Foreground="{ThemeResource AvenTextBrush}" />                        <TextBlock Text="Sp&#233;cialistes par t&#226;che" FontSize="10" TextWrapping="Wrap" TextAlignment="Center"                                   Foreground="{ThemeResource AvenMutedBrush}" />                    </StackPanel>                </Button>                <Button x:Name="CardFiles" Style="{StaticResource HubCardStyle}"                        Tag="2" Click="OnHubCard" AutomationProperties.Name="Fichiers &#8212; explorer l'espace">                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">                        <TextBlock Text="&#9636;" FontSize="24" Foreground="{ThemeResource AvenAccentBrush}" HorizontalAlignment="Center" />                        <TextBlock Text="Fichiers" FontWeight="SemiBold" HorizontalAlignment="Center"                                   Foreground="{ThemeResource AvenTextBrush}" />                        <TextBlock Text="Explorer l'espace" FontSize="10" TextWrapping="Wrap" TextAlignment="Center"                                   Foreground="{ThemeResource AvenMutedBrush}" />                    </StackPanel>                </Button>                <Button x:Name="CardNotes" Style="{StaticResource HubCardStyle}"                        Tag="3" Click="OnHubCard" AutomationProperties.Name="Notes &#8212; Markdown par agent">                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">                        <TextBlock Text="&#9998;" FontSize="24" Foreground="{ThemeResource AvenAccentBrush}" HorizontalAlignment="Center" />                        <TextBlock Text="Notes" FontWeight="SemiBold" HorizontalAlignment="Center"                                   Foreground="{ThemeResource AvenTextBrush}" />                        <TextBlock Text="Notes Markdown par agent" FontSize="10" TextWrapping="Wrap" TextAlignment="Center"                                   Foreground="{ThemeResource AvenMutedBrush}" />                    </StackPanel>                </Button>                </Grid>            </Grid>            <!-- PAGE CIBLE : socle de phase 2 (les vues r&#233;elles arrivent en phases 3-6) -->            <Grid x:Name="PageView" Visibility="Collapsed">                <Grid.ColumnDefinitions>                    <ColumnDefinition Width="Auto" />                    <ColumnDefinition Width="*" />                </Grid.ColumnDefinitions>                <!-- Sidebar conversations (parit&#233; .sidebar web v9.0.0) : liste group&#233;e                     par agent, recherche, bascule archiv&#233;es, actions — visible UNIQUEMENT                     sur la vue chat. -->                <Border x:Name="ChatSidebar" Grid.Column="0" Visibility="Collapsed" Width="260"                        Background="{ThemeResource AvenPanelBrush}"                        BorderBrush="{ThemeResource AvenBorderBrush}" BorderThickness="0,0,1,0">                    <Grid>                        <Grid.RowDefinitions>                            <RowDefinition Height="Auto" />                            <RowDefinition Height="Auto" />                            <RowDefinition Height="Auto" />                            <RowDefinition Height="*" />                            <RowDefinition Height="Auto" />                        </Grid.RowDefinitions>                        <Grid Grid.Row="0" Margin="14,12,14,0">                            <Grid.ColumnDefinitions>                                <ColumnDefinition Width="*" />                                <ColumnDefinition Width="Auto" />                            </Grid.ColumnDefinitions>                            <StackPanel Grid.Column="0" Spacing="2">                                <TextBlock Text="CONVERSATIONS" FontSize="11" FontWeight="SemiBold"                                           Foreground="{ThemeResource AvenAccentBrush}" />                                <TextBlock x:Name="SidebarTitre" Text="Actives" FontSize="14" FontWeight="SemiBold"                                           Foreground="{ThemeResource AvenTextBrush}" />                            </StackPanel>                            <Button Grid.Column="1" x:Name="SidebarNouvelle" Content="+" Click="OnSidebarNouvelle"                                    MinHeight="30" MinWidth="34" Padding="8,4"                                    Background="{ThemeResource AvenAccentBrush}" Foreground="White"                                    AutomationProperties.Name="Nouvelle conversation" />                        </Grid>                        <TextBox x:Name="SidebarRecherche" Grid.Row="1" PlaceholderText="Rechercher..."                                 Margin="14,10,14,0" MinHeight="32" TextChanged="OnSidebarRecherche"                                 Background="{ThemeResource AvenPanelBrush}"                                 BorderBrush="{ThemeResource AvenBorderBrush}" />                        <Button x:Name="SidebarArchive" Grid.Row="2" Content="Voir les archiv&#233;es"                                Click="OnSidebarArchive" Margin="14,8,14,0" MinHeight="30"                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"                                Background="{ThemeResource AvenPanelSoftBrush}" BorderThickness="0"                                Foreground="{ThemeResource AvenTextBrush}" />                        <ScrollViewer Grid.Row="3" Margin="0,8,0,0">                            <StackPanel x:Name="SidebarListe" Spacing="4" Margin="14,0,14,0" />                        </ScrollViewer>                        <Button Grid.Row="4" x:Name="SidebarNouvellePied" Content="+ Nouvelle conversation"                                Click="OnSidebarNouvelle" Margin="14,8,14,14" MinHeight="34"                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"                                Background="{ThemeResource AvenPanelSoftBrush}"                                Foreground="{ThemeResource AvenTextBrush}" />                    </Grid>                </Border>                <Grid Grid.Column="1">                <Grid.RowDefinitions>                    <RowDefinition Height="Auto" />                    <RowDefinition Height="*" />                    <RowDefinition Height="Auto" />                </Grid.RowDefinitions>                <ScrollViewer Grid.Row="0">                    <StackPanel MaxWidth="900" Spacing="14" Margin="32,24,32,42" Grid.Row="0" HorizontalAlignment="Left">                        <TextBlock x:Name="PageTitle" Text="" FontSize="28" FontWeight="SemiBold"                                   Foreground="{ThemeResource AvenTextBrush}" />                        <TextBlock x:Name="PageHint" Text="" FontSize="13" TextWrapping="Wrap"                                   Foreground="{ThemeResource AvenMutedBrush}" />                        <Border x:Name="PagePlaceholder" CornerRadius="18" Background="{ThemeResource AvenPanelBrush}"                                BorderBrush="{ThemeResource AvenBorderBrush}" BorderThickness="1"                                Padding="18">                            <TextBlock Text="Cette vue arrive en phases 3-6 du protocole MIGRATION-WINUI.md &#8212; la coquille, la navigation et le th&#232;me sont en place."                                       TextWrapping="Wrap" FontSize="13"                                       Foreground="{ThemeResource AvenMutedBrush}" />                        </Border>                        <!-- Panneau Param&#232;tres (jalon 3, parit&#233; SettingsDialog v9.3.0) :                             3 onglets Configuration | Apparence | Usage &#8212; masqu&#233; par                             d&#233;faut, visible par OnSettings seul. Les bascules/curseurs sont                             branch&#233;s en C# (signatures d&#233;l&#233;gu&#233;s), les clics via XAML. -->                        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="14">                            <StackPanel Orientation="Horizontal" Spacing="8">                                <Button x:Name="OngletConfiguration" Content="Configuration" Tag="config"                                        Click="OnOngletParametres" MinHeight="30" Padding="14,6" />                                <Button x:Name="OngletApparence" Content="Apparence" Tag="apparence"                                        Click="OnOngletParametres" MinHeight="30" Padding="14,6" />                                <Button x:Name="OngletUsage" Content="Usage" Tag="usage"                                        Click="OnOngletParametres" MinHeight="30" Padding="14,6" />                            </StackPanel>                            <!-- Onglet Configuration (parit&#233; renderGeneral) : cl&#233;s, notifications,                                 diagnostic, priorit&#233;s, espaces, sync, versions. -->                            <StackPanel x:Name="PanneauConfiguration" Spacing="14">                                <TextBlock Text="Cl&#233;s API" FontSize="16" FontWeight="SemiBold"                                           Foreground="{ThemeResource AvenTextBrush}" />                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AvenMutedBrush}"                                           Text="OpenRouter Free fournit les mod&#232;les gratuits des agents et Groq alimente la dict&#233;e vocale. Les cl&#233;s sont chiffr&#233;es par le syst&#232;me (DPAPI) et ne quittent jamais l&#8217;application." />                                <StackPanel x:Name="ClesListe" Spacing="10" />                                <TextBlock Text="Notifications de bureau" FontSize="16" FontWeight="SemiBold"                                           Foreground="{ThemeResource AvenTextBrush}" />                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AvenMutedBrush}"                                           Text="Pr&#233;vient quand un agent a besoin de toi : permission demand&#233;e, formulaire, tour termin&#233;. Jamais quand la fen&#234;tre est au premier plan." />                                <ToggleSwitch x:Name="BasculeNotifications" Header="Activer les notifications" />                                <StackPanel Orientation="Horizontal" Spacing="8">                                    <Button Content="Copier le diagnostic" Click="OnDiagnostic" MinHeight="32" Padding="12,6"                                            Background="{ThemeResource AvenPanelSoftBrush}"                                            Foreground="{ThemeResource AvenTextBrush}" />                                    <TextBlock x:Name="DiagnosticEtat" VerticalAlignment="Center" FontSize="12"                                               Foreground="{ThemeResource AvenMutedBrush}" />                                </StackPanel>                                <!-- Lot 5 (parit&#233; SettingsDialog v9.1.2) : statut + installation du CLI Freebuff. -->
                                <TextBlock Text="Freebuff CLI gratuit" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AvenTextBrush}" />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AvenMutedBrush}"
                                           Text="Le free tier de Freebuff (sessions quotidiennes, financ&#233; par les pubs texte) vit dans son CLI interactif. Il s'affiche DANS Aven (terminal int&#233;gr&#233;, session persistante) &#8212; la pastille &#171; Freebuff &#187; de l'accueil ouvre la vue ; &#171; Se connecter &#187; reste une console externe (action courte, incompatible avec une session ouverte)." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="CliFreebuffStatut" VerticalAlignment="Center" FontSize="13"
                                               Foreground="{ThemeResource AvenMutedBrush}" Text="V&#233;rification&#8230;" />
                                    <Button x:Name="CliFreebuffConnecter" Content="Se connecter" Click="OnCliFreebuffConnecter"
                                            Visibility="Collapsed" MinHeight="32" Padding="12,6"
                                            Background="{ThemeResource AvenPanelSoftBrush}" Foreground="{ThemeResource AvenTextBrush}" />
                                    <Button x:Name="CliFreebuffInstaller" Content="Installer le CLI (npm)" Click="OnCliFreebuffInstaller"
                                            MinHeight="32" Padding="12,6" Background="{ThemeResource AvenAccentBrush}" Foreground="White" />
                                </StackPanel>
                                <TextBlock Text="Priorit&#233; des mod&#232;les par agent" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AvenTextBrush}" />                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AvenMutedBrush}"                                           Text="Chaque agent re&#231;oit le premier mod&#232;le disponible de sa cha&#238;ne de priorit&#233; ; le routeur passe au suivant si ce mod&#232;le est indisponible." />                                <TextBlock x:Name="PrioritesTexte" TextWrapping="Wrap" FontSize="13"                                           Foreground="{ThemeResource AvenTextBrush}" />                                <TextBlock Text="Espaces" FontSize="16" FontWeight="SemiBold"                                           Foreground="{ThemeResource AvenTextBrush}" />                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AvenMutedBrush}"                                           Text="Chaque espace a ses propres conversations, agents et priorit&#233;s. Les cl&#233;s API sont partag&#233;es entre tous. Retirer le dernier espace ram&#232;ne &#224; l&#8217;&#233;cran de choix." />                                <StackPanel x:Name="EspacesListe" Spacing="6" />                                <StackPanel Orientation="Horizontal" Spacing="8">                                    <Button Content="Cr&#233;er un nouvel espace&#8230;" Click="OnParamCreerEspace"                                            MinHeight="34" Padding="12,6" Background="{ThemeResource AvenAccentBrush}"                                            Foreground="White" />                                    <Button Content="Ouvrir un dossier existant&#8230;" Click="OnParamOuvrirEspace"                                            MinHeight="34" Padding="12,6" Background="{ThemeResource AvenPanelSoftBrush}"                                            Foreground="{ThemeResource AvenTextBrush}" />                                </StackPanel>                                <TextBlock x:Name="EspaceErreur" TextWrapping="Wrap" FontSize="13"                                           Foreground="{ThemeResource AvenDangerBrush}" />                                <TextBlock Text="Fichiers de config du dossier de travail" FontSize="16" FontWeight="SemiBold"                                           Foreground="{ThemeResource AvenTextBrush}" />                                <TextBlock x:Name="SyncTexte" TextWrapping="Wrap" FontSize="13"                                           Foreground="{ThemeResource AvenMutedBrush}" />                                <Border CornerRadius="18" Background="{ThemeResource AvenPanelBrush}"
                                        BorderBrush="{ThemeResource AvenBorderBrush}" BorderThickness="1" Padding="18">
                                    <TextBlock x:Name="SettingsVersion" FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource AvenMutedBrush}" />
                                </Border>
                                <!-- Lot 5 (parit&#233; main.ts:800 checkForUpdates) : rang&#233;e mise &#224; jour.                                     Sans canal de mise &#224; jour c&#244;t&#233; natif (UpdatesConfigured = false),
                                     m&#234;me rendu que le web non configur&#233; : message, pas de bouton. -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BoutonVerifierMisesAJour" Content="V&#233;rifier les mises &#224; jour" Click="OnVerifierMisesAJour"
                                            Visibility="Collapsed" MinHeight="32" Padding="12,6"
                                            Background="{ThemeResource AvenPanelSoftBrush}" Foreground="{ThemeResource AvenTextBrush}" />
                                    <TextBlock x:Name="MisesAJourMessage" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AvenMutedBrush}" />
                                </StackPanel>
                            </StackPanel>                            <!-- Onglet Apparence (parit&#233; renderAppearance, champs applicables) -->                            <StackPanel x:Name="PanneauApparence" Visibility="Collapsed" Spacing="14">                                <TextBlock Text="Th&#232;me" FontSize="16" FontWeight="SemiBold"                                           Foreground="{ThemeResource AvenTextBrush}" />                                <StackPanel Orientation="Horizontal" Spacing="8">                                    <Button x:Name="BoutonThemeClair" Content="Clair" Tag="light" Click="OnChoisirTheme"                                            MinHeight="30" Padding="14,6" />                                    <Button x:Name="BoutonThemeSysteme" Content="Syst&#232;me" Tag="system" Click="OnChoisirTheme"                                            MinHeight="30" Padding="14,6" />                                    <Button x:Name="BoutonThemeSombre" Content="Sombre" Tag="dark" Click="OnChoisirTheme"                                            MinHeight="30" Padding="14,6" />                                </StackPanel>                                <TextBlock Text="Accent" FontSize="16" FontWeight="SemiBold"                                           Foreground="{ThemeResource AvenTextBrush}" />                                <StackPanel Orientation="Horizontal" Spacing="8">                                    <Button x:Name="BoutonAccentViolet" Content="Violet" Tag="violet" Click="OnChoisirAccent"                                            MinHeight="30" Padding="12,6" />                                    <Button x:Name="BoutonAccentBleu" Content="Bleu" Tag="blue" Click="OnChoisirAccent"                                            MinHeight="30" Padding="12,6" />                                    <Button x:Name="BoutonAccentEmeraude" Content="&#201;meraude" Tag="emerald" Click="OnChoisirAccent"                                            MinHeight="30" Padding="12,6" />                                    <Button x:Name="BoutonAccentRose" Content="Rose" Tag="rose" Click="OnChoisirAccent"                                            MinHeight="30" Padding="12,6" />                                    <Button x:Name="BoutonAccentAmbre" Content="Ambre" Tag="amber" Click="OnChoisirAccent"                                            MinHeight="30" Padding="12,6" />                                    <Button x:Name="BoutonAccentPerso" Content="Personnalis&#233;e" Tag="custom" Click="OnChoisirAccent"                                            MinHeight="30" Padding="12,6" />                                </StackPanel>                                <ColorPicker x:Name="ChoixCouleur" Visibility="Collapsed" IsAlphaEnabled="False"                                             Width="280" Height="230" />                                <StackPanel Spacing="6">                                    <TextBlock x:Name="EtiquetteLargeurSidebar" FontSize="13"                                               Foreground="{ThemeResource AvenTextBrush}" />                                    <Slider x:Name="CurseurLargeurSidebar" Minimum="240" Maximum="420" StepFrequency="2"                                            Margin="0,0,120,0" />                                    <TextBlock x:Name="EtiquetteLargeurMessages" FontSize="13"                                               Foreground="{ThemeResource AvenTextBrush}" />                                    <Slider x:Name="CurseurLargeurMessages" Minimum="560" Maximum="1100" StepFrequency="10"                                            Margin="0,0,120,0" />                                </StackPanel>                                <TextBlock Text="&#201;l&#233;ments de l&#8217;interface" FontSize="16" FontWeight="SemiBold"                                           Foreground="{ThemeResource AvenTextBrush}" />                                <ToggleSwitch x:Name="BasculeSidebar" Header="Conversations" Tag="sidebar" />                                <ToggleSwitch x:Name="BasculeModele" Header="Mod&#232;le actif" Tag="model" />                                <ToggleSwitch x:Name="BasculeCompositeur" Header="&#201;diteur de message" Tag="composer" />                                <ToggleSwitch x:Name="BasculeGroupement" Header="Grouper les conversations par agent" Tag="group" />                                <TextBlock Text="Annonce vocale" FontSize="16" FontWeight="SemiBold"                                           Foreground="{ThemeResource AvenTextBrush}" />                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AvenMutedBrush}"                                           Text="Annonce &#224; voix haute (voix Windows, hors ligne) les moments cl&#233;s des agents : permission demand&#233;e, tour termin&#233;, bascule de mod&#232;le. Jamais le contenu des r&#233;ponses. La voix se coupe automatiquement quand tu tapes." />                                <ToggleSwitch x:Name="BasculeVoix" Header="Annoncer les &#233;v&#233;nements des agents" Tag="voice" />                                <Button Content="Tester la voix" Click="OnTesterVoix" MinHeight="32" Padding="12,6"                                        Background="{ThemeResource AvenPanelSoftBrush}"                                        Foreground="{ThemeResource AvenTextBrush}" />                                <StackPanel Orientation="Horizontal" Spacing="8">                                    <Button Content="R&#233;initialiser" Click="OnResetApparence" MinHeight="32" Padding="12,6"                                            Background="{ThemeResource AvenPanelSoftBrush}"                                            Foreground="{ThemeResource AvenTextBrush}" />                                    <TextBlock x:Name="ApparenceEtat" VerticalAlignment="Center" FontSize="12"                                               Foreground="{ThemeResource AvenMutedBrush}" />                                </StackPanel>                            </StackPanel>                            <!-- Onglet Usage (parit&#233; renderUsage v9.3.0) : tuiles construites en C#. -->                            <StackPanel x:Name="PanneauUsage" Visibility="Collapsed" Spacing="12">                                <TextBlock Text="Usage de l&#8217;application" FontSize="16" FontWeight="SemiBold"                                           Foreground="{ThemeResource AvenTextBrush}" />                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AvenMutedBrush}"                                           Text="Conversations, dict&#233;es et mod&#232;les &#8212; compt&#233;s dans l&#8217;espace actif." />                                <StackPanel x:Name="UsageStats" Spacing="8" />                                <StackPanel Orientation="Horizontal" Spacing="8">                                    <Button Content="Actualiser" Click="OnUsageActualiser" MinHeight="32" Padding="12,6"                                            Background="{ThemeResource AvenPanelSoftBrush}"                                            Foreground="{ThemeResource AvenTextBrush}" />                                    <TextBlock x:Name="UsageEtat" VerticalAlignment="Center" FontSize="12"                                               Foreground="{ThemeResource AvenMutedBrush}" />                                </StackPanel>                            </StackPanel>                        </StackPanel>                        <Button Content="&#8592; Retour au hub" Click="OnHome" MinHeight="36" Padding="14,6"                                Background="{ThemeResource AvenPanelSoftBrush}"                                Foreground="{ThemeResource AvenTextBrush}" />                    </StackPanel>                </ScrollViewer><ScrollViewer x:Name="ChatScroll" Grid.Row="1" Visibility="Collapsed">                    <StackPanel x:Name="ChatRows" MaxW