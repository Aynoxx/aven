<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tokens Aven (parit&#233; web/src/App.css &#8212; test&#233;e par AvenThemeParityTests).
         Les valeurs dupliquent AvenTheme.cs : le test de parit&#233; compare le C# au CSS ;
         ici le XAML lit les M&#202;MES constantes via x:Static quand possible, sinon valeur litt&#233;rale. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AvenBgColor">#FDFCFE</Color>
            <Color x:Key="AvenPanelColor">#FFFFFF</Color>
            <Color x:Key="AvenPanelSoftColor">#EEF0F6</Color>
            <Color x:Key="AvenBorderColor">#14182617</Color>
            <Color x:Key="AvenBorderStrongColor">#14182626</Color>
            <Color x:Key="AvenTextColor">#171923</Color>
            <Color x:Key="AvenMutedColor">#707689</Color>
            <SolidColorBrush x:Key="AvenBgBrush" Color="{StaticResource AvenBgColor}" />
            <SolidColorBrush x:Key="AvenPanelBrush" Color="{StaticResource AvenPanelColor}" />
            <SolidColorBrush x:Key="AvenPanelSoftBrush" Color="{StaticResource AvenPanelSoftColor}" />
            <SolidColorBrush x:Key="AvenBorderBrush" Color="{StaticResource AvenBorderColor}" />
            <SolidColorBrush x:Key="AvenBorderStrongBrush" Color="{StaticResource AvenBorderStrongColor}" />
            <SolidColorBrush x:Key="AvenTextBrush" Color="{StaticResource AvenTextColor}" />
            <SolidColorBrush x:Key="AvenMutedBrush" Color="{StaticResource AvenMutedColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AvenBgColor">#12151D</Color>
            <Color x:Key="AvenPanelColor">#12151D</Color>
            <Color x:Key="AvenPanelSoftColor">#171B24</Color>
            <Color x:Key="AvenBorderColor">#FFFFFF14</Color>
            <Color x:Key="AvenBorderStrongColor">#FFFFFF24</Color>
            <Color x:Key="AvenTextColor">#F4F5F8</Color>
            <Color x:Key="AvenMutedColor">#9299AA</Color>
            <SolidColorBrush x:Key="AvenBgBrush" Color="{StaticResource AvenBgColor}" />
            <SolidColorBrush x:Key="AvenPanelBrush" Color="{StaticResource AvenPanelColor}" />
            <SolidColorBrush x:Key="AvenPanelSoftBrush" Color="{StaticResource AvenPanelSoftColor}" />
            <SolidColorBrush x:Key="AvenBorderBrush" Color="{StaticResource AvenBorderColor}" />
            <SolidColorBrush x:Key="AvenBorderStrongBrush" Color="{StaticResource AvenBorderStrongColor}" />
            <SolidColorBrush x:Key="AvenTextBrush" Color="{StaticResource AvenTextColor}" />
            <SolidColorBrush x:Key="AvenMutedBrush" Color="{StaticResource AvenMutedColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Accent et s&#233;mantiques : identiques dans les deux th&#232;mes (parit&#233; App.css). -->
    <Color x:Key="AvenAccentColor">#8B5CF6</Color>
    <Color x:Key="AvenDangerColor">#EF4444</Color>
    <Color x:Key="AvenSuccessColor">#10B981</Color>
    <Color x:Key="AvenWarningColor">#F59E0B</Color>
    <SolidColorBrush x:Key="AvenAccentBrush" Color="{StaticResource AvenAccentColor}" />
    <SolidColorBrush x:Key="AvenAccentSoftBrush" Color="#148B5CF6" />
    <SolidColorBrush x:Key="AvenAccentBorderBrush" Color="#4D8B5CF6" />
    <SolidColorBrush x:Key="AvenDangerBrush" Color="{StaticResource AvenDangerColor}" />
    <SolidColorBrush x:Key="AvenSuccessBrush" Color="{StaticResource AvenSuccessColor}" />
    <SolidColorBrush x:Key="AvenWarningBrush" Color="{StaticResource AvenWarningColor}" />

    <!-- Motion v9.7.0 : dur&#233;es (ms) et courbes (KeySpline = points de contr&#244;le). -->
    <x:Double x:Key="AvenDurFast">120</x:Double>
    <x:Double x:Key="AvenDurMed">240</x:Double>
    <x:Double x:Key="AvenDurSlow">380</x:Double>
    <x:Double x:Key="AvenStaggerStep">45</x:Double>
    <KeySpline x:Key="AvenEaseOut">0.22,1 0.36,1</KeySpline>
    <KeySpline x:Key="AvenEaseSpring">0.34,1.56 0.64,1</KeySpline>

    <!-- Rayons de cartes (parit&#233; .hub-card 22px, .agent-card 18px, ic&#244;nes 15px). -->
    <CornerRadius x:Key="AvenCardCorner">22</CornerRadius>
    <CornerRadius x:Key="AvenPageCardCorner">18</CornerRadius>
    <CornerRadius x:Key="AvenIconCorner">15</CornerRadius>
</ResourceDictionary>
