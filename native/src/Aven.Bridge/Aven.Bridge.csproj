<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aven.Bridge — pont JSON-RPC 2.0 (stdio) vers le moteur Aven.Engine (sidecar Node).
       Phase 0 du protocole MIGRATION-WINUI.md ; le host Node arrive en phase 1. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Aven.Bridge</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- CA1416 (DPAPI = Windows uniquement) : le pont ne vise que Windows en
         pratique (cible du protocole), le TFM reste net8.0 pour les tests. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Stockage des stats (décision §5.3 du protocole) : historique journalier en
       SQLite — le JSON de compatibilité Classic ne porte aucun historique. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <!-- Clés API chiffrées DPAPI (jalon parité v10.0.0) : parité du safeStorage
         Electron (Windows = DPAPI CurrentUser), avec import du store Classic. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
